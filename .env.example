# ──────────────────────────────────────────────────────────────────────────────
# Lectern Environment Variables Configuration Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to '.env' at the project root:
#   cp .env.example .env
#
# Development defaults are pre-configured to run out-of-the-box with Docker Compose.
# For production deployments, ensure all secrets and domains are securely updated.
# ──────────────────────────────────────────────────────────────────────────────

# 0. Docker Compose Profiles
# ──────────────────────────────────────────────────────────────────────────────
# Active Compose profiles (comma-separated). Controls which optional service
# groups start.
#
# Available profiles:
#   postgres         — local PostgreSQL container. Remove to use a remote DB.
#   seaweedfs-dev    — local SeaweedFS single-node (S3 gateway on :8333).
#   seaweedfs-prod   — production SeaweedFS cluster (master + 2 volumes + filer + S3 gateway).
#   selfhost-worker  — self-hosted HMAC-signed delivery worker (replaces Cloudflare Worker).
#
# Default (local dev):
COMPOSE_PROFILES=postgres,seaweedfs-dev


# 1. General & Core Settings
# ──────────────────────────────────────────────────────────────────────────────
# Application runtime environment (development, production, or test).
# Default: development
ENVIRONMENT=development

# Secret key used for signing JWTs and deriving CAS HMACs.
# Generate a strong key with: openssl rand -hex 32
# Default: change-this-to-a-secure-random-string-with-at-least-32-bytes
SECRET_KEY=change-this-to-a-secure-random-string-with-at-least-32-bytes

# Whether to run database migrations automatically on container startup.
# Default: true
#RUN_MIGRATIONS=true

# Comma-separated list of headers allowed by CORS. Shared between FastAPI & Nginx.
# Default: Content-Type,Authorization,X-Client-ID,X-Upload-ID,Accept,X-Requested-With,Upload-Checksum,Tus-Checksum-Algorithm
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Client-ID,X-Upload-ID,Accept,X-Requested-With,Upload-Checksum,Tus-Checksum-Algorithm

# Immediate reverse-proxy IPs/CIDRs whose X-Forwarded-* headers the API trusts.
# Compose supplies loopback plus private Docker bridge ranges by default. Add
# every upstream load balancer/reverse-proxy address in the forwarded chain, or
# rate limits will see the first omitted proxy instead of the client. For a
# bare-metal deployment, list only the actual proxy addresses.
#TRUSTED_PROXY_HOSTS=127.0.0.1,::1


# 2. Network & Frontend Settings
# ──────────────────────────────────────────────────────────────────────────────
# Public base URL of the frontend. Used for CORS and email magic links.
# Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Browser-facing API base path.
# Default: /api
NEXT_PUBLIC_API_URL=/api

# Browser-facing EuroOffice document server URL.
# Default: http://localhost/eurooffice
NEXT_PUBLIC_EUROOFFICE_URL=http://localhost/eurooffice

# Source repository URL for footer/About links. Left empty to hide links.
# Default: (unset)
NEXT_PUBLIC_REPO_URL=

# Build-time commit SHA shown in the About panel (usually injected at build-time).
# Default: (unset)
#NEXT_PUBLIC_COMMIT_SHA=

# Fallback client-side upload size limit in megabytes.
# Default: 100
#NEXT_PUBLIC_MAX_FILE_SIZE_MB=100

# In-app interactive tutorials (guided tours), build-time kill-switch. Set to
# off/false/0 to hard-disable at build. For a runtime toggle prefer the
# backend TUTORIALS_ENABLED (below); this still wins if set.
# Default: on
#NEXT_PUBLIC_TUTORIALS=on

# Internal API URL for Server-Side Rendering (SSR) and rewrites.
# Default: http://api:8000
#API_INTERNAL_URL=http://api:8000


# 3. PostgreSQL Database
# ──────────────────────────────────────────────────────────────────────────────
# Note: These values are used by the PostgreSQL container on first startup,
# and by the API to connect to the database. Keep them consistent.

# PostgreSQL username.
# Default: lectern
POSTGRES_USER=lectern

# PostgreSQL password.
# Default: lectern_dev_password
POSTGRES_PASSWORD=lectern_dev_password

# PostgreSQL database name.
# Default: lectern
POSTGRES_DB=lectern

# PostgreSQL database host (use service name 'postgres' inside Docker Compose).
# Default: postgres
POSTGRES_HOST=postgres

# PostgreSQL database port.
# Default: 5432
POSTGRES_PORT=5432

# Async connection URL used by the API to connect to the database.
# Default: postgresql+asyncpg://lectern:lectern@localhost:5432/lectern
DATABASE_URL=postgresql+asyncpg://lectern:lectern_dev_password@postgres:5432/lectern


# 4. Redis Cache & Queue
# ──────────────────────────────────────────────────────────────────────────────
# Redis connection URL. Backs caching, rate limiting, and background queues.
# Default: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0


# 5. Meilisearch Full-Text Search
# ──────────────────────────────────────────────────────────────────────────────
# Meilisearch service endpoint.
# Default: http://localhost:7700
MEILI_URL=http://meilisearch:7700

# Admin master key used to manage indices. The startup validator rejects the default key in production.
# Default: change-me
MEILI_MASTER_KEY=change-me-to-a-random-key

# Search-only key used by the public search route. Provision via Meilisearch admin API.
# If unset, the app falls back to the master key with a warning in development.
# Default: (unset)
MEILI_SEARCH_KEY=change-me-to-a-random-search-key


# 6. Content-Addressed Storage (CAS)
# ──────────────────────────────────────────────────────────────────────────────
# Domain-separation constants for CAS key derivation (HKDF over SECRET_KEY).
# They determine S3 object keys (cas/) and Redis deduplication keys.
# WARNING: Keep constant for the life of a deployment. If you change them on an
# existing deployment, new uploads will stop deduplicating against existing ones.

# HKDF Salt seeding CAS key derivation.
# Default: lectern-cas-salt-v1
#CAS_HKDF_SALT=lectern-cas-salt-v1

# HKDF Info paired with CAS_HKDF_SALT.
# Default: lectern-cas-v1
#CAS_HKDF_INFO=lectern-cas-v1

# How long in seconds a CAS entry is trusted before re-scanning for malware.
# Default: 604800 (7 days). 0 disables staleness checks (always trust).
#CAS_MAX_AGE_SECONDS=604800


# 7. Object Storage (S3-compatible)
# ──────────────────────────────────────────────────────────────────────────────
# The platform is storage-backend-agnostic. All backends use S3-compatible APIs.
# Supported backends: seaweedfs (dev default), r2 (Cloudflare), garage, rustfs.
# Default: r2
STORAGE_BACKEND=seaweedfs

# Internal S3 endpoint the API talks to (use 'seaweedfs:8333' for local dev).
# Default: localhost:9000
S3_ENDPOINT=seaweedfs:8333

# Endpoint the browser talks to for direct uploads/downloads.
# Default: (unset)
S3_PUBLIC_ENDPOINT=localhost/s3

# S3 Access Key.
# Default: minioadmin
S3_ACCESS_KEY=minioadmin

# S3 Secret Key.
# Default: minioadmin
S3_SECRET_KEY=minioadmin

# S3 Bucket name.
# Default: lectern
S3_BUCKET=lectern

# S3 Region. For Cloudflare R2, this is effectively ignored/auto.
# Default: us-east-1
#S3_REGION=us-east-1

# Set to true when the S3 endpoint uses HTTPS.
# Default: false
S3_USE_SSL=false

# SeaweedFS image used by both development and self-hosted production profiles.
# Development may use the fixed release tag below. Production deployments must
# override this with the tested immutable RepoDigest, for example
# chrislusf/seaweedfs:4.29@sha256:<manifest-digest>.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.29

# Production accepts only immutable digests copied into the post-scan release
# repositories. Candidate and legacy repository digests are rejected by Compose.
#API_IMAGE=ghcr.io/theo-darvoux/lectern/api-release@sha256:<64-hex-manifest-digest>
#WORKER_IMAGE=ghcr.io/theo-darvoux/lectern/worker-release@sha256:<64-hex-manifest-digest>
#WEB_IMAGE=ghcr.io/theo-darvoux/lectern/web-release@sha256:<64-hex-manifest-digest>
#SELFHOST_WORKER_IMAGE=ghcr.io/theo-darvoux/lectern/selfhost-worker-release@sha256:<64-hex-manifest-digest>

# Enable S3 Transfer Acceleration (AWS S3 only).
# Default: false
#S3_USE_ACCELERATE_ENDPOINT=false

# Total storage quota in GB across all materials.
# Default: 10
#MAX_STORAGE_GB=10


# 8. Signed Delivery via Worker (Optional)
# ──────────────────────────────────────────────────────────────────────────────
# When set, downloads and branding assets are served via an HMAC-signed,
# edge-cached worker instead of presigned S3 GETs. Works with the Cloudflare
# worker or the self-hosted Node worker (worker/src/node/server.ts).
# Leave empty to fall back to presigned S3 URLs / server-side streaming.

# Worker base URL.
# Default: (unset)
WORKER_ZIP_URL=

# Shared HMAC secret matching the worker's configuration.
# Default: (unset)
WORKER_ZIP_HMAC_SECRET=


# 9. Document Editing (EuroOffice / ONLYOFFICE)
# ──────────────────────────────────────────────────────────────────────────────
# JWT secret shared between the API and EuroOffice Document Server.
# Default: change-me-eurooffice-jwt-secret
EUROOFFICE_JWT_SECRET=insecure-dev-only-eurooffice-secret

# Separate secret for file-access tokens (API-only).
# MUST differ from EUROOFFICE_JWT_SECRET in production to prevent privilege escalation.
# Default: change-me-eurooffice-file-token-secret
EUROOFFICE_FILE_TOKEN_SECRET=insecure-dev-only-eurooffice-file-token-secret

# Short-lived file-access token lifetime in seconds.
# Default: 60
#EUROOFFICE_FILE_TOKEN_TTL=60

# Internal URL used by EuroOffice Document Server container to fetch files from the API.
# Default: http://api:8000
EUROOFFICE_INTERNAL_API_BASE_URL=http://api:8000


# 10. Authentication & Domains
# ──────────────────────────────────────────────────────────────────────────────
# Enable TOTP (authenticator-app) two-factor authentication.
# Default: true
#TOTP_ENABLED=true

# Enable "Sign in with Google" (requires GOOGLE_CLIENT_ID).
# Default: false
#GOOGLE_OAUTH_ENABLED=false

# Google OAuth Client ID.
# Default: (unset)
#GOOGLE_CLIENT_ID=

# Enable classic email + password authentication.
# Default: false
#CLASSIC_AUTH_ENABLED=false

# Allow unauthenticated read-only browsing of course materials.
# Default: false
#GUEST_ACCESS_ENABLED=false

# Enable the in-app guided tours (tutorials). Set to false to disable platform-wide:
# no first-visit auto-launch and the Help center hides them. Runtime toggle.
# Default: true
#TUTORIALS_ENABLED=true

# Accept sign-ups from any email domain (bypasses domain restrictions).
# Default: false
#ALLOW_ALL_DOMAINS=false

# Auto-approve every new user account instead of holding for staff review.
# Default: false
#AUTO_APPROVE_ALL_DOMAINS=false

# Allowed email domains. Comma-separated list of "domain:auto" or "domain:manual".
# "auto" = auto-approved on registration; "manual" = requires staff approval.
# Leave empty to use the 'allowed_domains' database table.
# Default: (unset)
ALLOWED_DOMAINS=

# JWT Access Token lifetime in days.
# Default: 7
#JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# JWT Refresh Token lifetime in days.
# Default: 31
#JWT_REFRESH_TOKEN_EXPIRE_DAYS=31


# 11. Email / SMTP Configuration
# ──────────────────────────────────────────────────────────────────────────────
# SMTP server hostname.
# Default: smtp.example.com
SMTP_HOST=smtp.example.com

# SMTP server port (usually 587 for TLS, 465 for SSL, or 25).
# Default: 587
SMTP_PORT=587

# SMTP username.
# Default: (unset)
SMTP_USER=

# SMTP password.
# Default: (unset)
SMTP_PASSWORD=

# 'From:' address on outgoing mail.
# Default: (unset)
SMTP_FROM=

# Use STARTTLS for SMTP connections.
# Default: true
SMTP_USE_TLS=true

# Optional: Override hostname with specific IP for SMTP connection (flaky DNS).
# Default: (unset)
#SMTP_IP=

# Optional: Display name shown in From: header (e.g. Lectern).
# Default: (unset)
#SMTP_SENDER_NAME=Lectern

# Optional: URL of avatar image shown in verification emails.
# Default: (unset)
#SMTP_AVATAR_URL=


# 12. Branding
# ──────────────────────────────────────────────────────────────────────────────
# Instance display name shown in the UI, page titles and emails.
# Default: Lectern
#SITE_NAME=Lectern

# Meta description / tagline for the site.
# Default: Collaborative course materials platform
#SITE_DESCRIPTION=Collaborative course materials platform

# Accent primary color (hex format).
# Default: #3b82f6
#PRIMARY_COLOR=#3b82f6

# Custom footer text. Hidden if empty.
# Default: (unset)
#FOOTER_TEXT=© 2026 Lectern

# Link behind the organization name in the footer.
# Default: (unset)
#ORGANIZATION_URL=https://example.com

# Custom logo asset URL (S3 path or static web URL).
# Default: (unset)
#SITE_LOGO_URL=

# Custom favicon asset URL.
# Default: (unset)
#SITE_FAVICON_URL=

# Open Graph preview image URL (social sharing).
# Default: (unset)
#OG_IMAGE_URL=

# Background watermark image URL.
# Default: (unset)
#BG_WATERMARK_URL=

# Background watermark opacity in light mode (0.0 to 1.0).
# Default: 0.05
#BG_WATERMARK_OPACITY_LIGHT=0.05

# Background watermark opacity in dark mode (0.0 to 1.0).
# Default: 0.08
#BG_WATERMARK_OPACITY_DARK=0.08

# Logo asset URL shown in the footer.
# Default: (unset)
#FOOTER_LOGO_URL=

# Advanced: JSON array of styled name segments for a multi-color wordmark.
# Don't hand-write this: build it visually in the admin dashboard
# (Config -> Branding -> Wordmark Builder), then paste the generated line here.
# Set the raw JSON without surrounding quotes. See docs/configuration.md.
# Default: (unset)
#SITE_NAME_STYLE=


# 13. Legal / GDPR
# ──────────────────────────────────────────────────────────────────────────────
# Legal entity name.
# Default: (unset)
#LEGAL_NAME=

# Registered address of the legal entity.
# Default: (unset)
#LEGAL_ADDRESS=

# SIRET / Company registration number.
# Default: (unset)
#LEGAL_SIRET=

# Public support / contact email address.
# Default: (unset)
#CONTACT_EMAIL=

# Data Protection Officer (DPO) email address.
# Default: (unset)
#DPO_EMAIL=

# DPO postal address.
# Default: (unset)
#DPO_ADDRESS=

# Statement on international data transfers.
# Default: Vos données sont hébergées et traitées exclusivement au sein de l'Union européenne. Aucun transfert vers un pays tiers n'est effectué.
#DATA_TRANSFERS="Vos données sont hébergées et traitées exclusivement au sein de l'Union européenne. Aucun transfert vers un pays tiers n'est effectué."

# Version stamp of the legal terms.
# Default: 1.0
#LEGAL_VERSION=1.0


# 14. File Pipeline & Limits
# ──────────────────────────────────────────────────────────────────────────────
# Size caps are enforced server-side before transfer/processing (in megabytes).

# Global hard limit for any single file upload.
# Default: 100
#MAX_FILE_SIZE_MB=100

# Category cap for SVGs.
# Default: 5
#MAX_SVG_SIZE_MB=5

# Category cap for images.
# Default: 50
#MAX_IMAGE_SIZE_MB=50

# Category cap for audio files.
# Default: 200
#MAX_AUDIO_SIZE_MB=200

# Category cap for video files.
# Default: 500
#MAX_VIDEO_SIZE_MB=500

# Category cap for PDF documents.
# Default: 200
#MAX_DOCUMENT_SIZE_MB=200

# Category cap for Office files.
# Default: 100
#MAX_OFFICE_SIZE_MB=100

# Category cap for text/code files.
# Default: 20
#MAX_TEXT_SIZE_MB=20

# Comma-separated allowed file extensions, e.g. '.pdf,.docx'. Empty = all.
# Default: (unset)
#ALLOWED_EXTENSIONS=

# Comma-separated allowed MIME types. Empty = all.
# Default: (unset)
#ALLOWED_MIME_TYPES=

# PDF compression quality level (0 to 100).
# Default: 75
#PDF_QUALITY=75

# Ghostscript quality alias (screen, ebook, printer, prepress). Overrides PDF_QUALITY.
# Default: (unset)
#PDF_COMPRESSION_LEVEL=

# ffmpeg video compression profile: none, light, medium, aggressive, heavy, extreme.
# Default: medium
#VIDEO_COMPRESSION_PROFILE=medium

# Thumbnail JPEG quality (0 to 100).
# Default: 85
#THUMBNAIL_QUALITY=85

# Thumbnail longest-edge size in pixels.
# Default: 640
#THUMBNAIL_SIZE_PX=640


# 15. Tus Resumable Upload Internals (Advanced)
# ──────────────────────────────────────────────────────────────────────────────
# Advanced settings for the resumable upload pipeline. Rarely need modification.

# Hard deadline in seconds for the entire upload and processing pipeline.
# Default: 600
#UPLOAD_PIPELINE_MAX_SECONDS=600

# Minimum chunk size in bytes (must be at least 5 MiB for S3 compatibility).
# Default: 5242880 (5 MiB)
#TUS_CHUNK_MIN_BYTES=5242880

# Maximum chunk size in bytes.
# Default: 104857600 (100 MiB)
#TUS_CHUNK_MAX_BYTES=104857600

# Maximum size in bytes for a resumable upload.
# Default: 524288000 (500 MiB)
#TUS_MAX_SIZE_BYTES=524288000

# Maximum concurrent resumable uploads per user.
# Default: 8
#TUS_MAX_CONCURRENT_PER_USER=8

# Enable presigned multipart uploads to speed up large files.
# Default: true
#ENABLE_PRESIGNED_MULTIPART=true

# Files smaller than this size in megabytes bypass multipart and upload directly.
# Default: 10
#DIRECT_UPLOAD_THRESHOLD_MB=10


# 16. Malware Scanning
# ──────────────────────────────────────────────────────────────────────────────
# Path to the compiled YARA rules directory.
# Default: yara_rules
YARA_RULES_DIR=yara_rules

# Maximum scan time in seconds before aborting the YARA scan.
# Default: 60
#YARA_SCAN_TIMEOUT=60

# MalwareBazaar API endpoint.
# Default: https://mb-api.abuse.ch/api/v1/
#MALWAREBAZAAR_URL=https://mb-api.abuse.ch/api/v1/

# Optional API key for MalwareBazaar to avoid rate limit throttling.
# Default: (unset)
#MALWAREBAZAAR_API_KEY=your-api-key-here

# MalwareBazaar API timeout in seconds.
# Default: 5
MALWAREBAZAAR_TIMEOUT=5

# Whether a MalwareBazaar error/timeout should fail the upload (fail-closed).
# Default: true
MALWAREBAZAAR_FAIL_CLOSED=true

# Run MalwareBazaar asynchronously in background jobs (faster uploads).
# Default: true
#BAZAAR_ASYNC_ENABLED=true

# Retroactively soft-delete approved materials referencing a flagged S3 key.
# Default: true
#BAZAAR_RETROACTIVE_CHECK_MATERIALS=true


# 17. Pull Request Limits
# ──────────────────────────────────────────────────────────────────────────────
# Operation and resource limits for the collaborative pull-request flow.

# Max operations (add, delete, move) per PR for student accounts.
# Default: 50
#PR_MAX_OPS_STUDENT=50

# Max operations per PR for staff accounts.
# Default: 500
#PR_MAX_OPS_STAFF=500

# Max attachments allowed per material in a single PR.
# Default: 50
#PR_MAX_ATTACHMENTS_PER_MATERIAL=50

# Max simultaneously open PRs allowed per user.
# Default: 5
#PR_MAX_OPEN_PER_USER=5

# Days before an inactive PR automatically expires.
# Default: 7
#PR_EXPIRY_DAYS=7

# Window in days during which a merged PR can be reverted by the author.
# Default: 7
#PR_REVERT_GRACE_DAYS=7


# 18. Scaling & Worker Concurrency
# ──────────────────────────────────────────────────────────────────────────────
# Options for worker process scaling and internal concurrency.

# Number of worker-fast containers. Default in compose.yaml: 1 (dev). Set to 2+ in prod.
#WORKER_FAST_REPLICAS=2

# Concurrent jobs per fast worker (small files; I/O-bound, safe to over-subscribe).
# Default: 4
#WORKER_FAST_MAX_JOBS=4

# Number of worker-slow containers. Default in compose.yaml: 1 (dev). Set to 2+ in prod.
#WORKER_SLOW_REPLICAS=2

# Concurrent jobs per slow worker (large files/video; CPU-bound, keep low).
# Default: 2
#WORKER_SLOW_MAX_JOBS=2

# Private root for all temporary upload-processing files. Must be an absolute,
# non-symlink directory owned by the application user.
# Default in compose: /var/lib/lectern/processing
#PROCESSING_ROOT=/var/lib/lectern/processing

# Per-sandbox resource ceilings. Values are enforced by prlimit in addition to
# the worker container's aggregate CPU/memory/PID limits.
#SANDBOX_MEMORY_LIMIT_MB=1024
#SANDBOX_CPU_LIMIT_SECONDS=60
#SANDBOX_FILE_SIZE_LIMIT_MB=100
#SANDBOX_PROCESS_LIMIT=64

# Distributed limit for heavy subprocesses across all worker replicas.
# Every replica must use the same positive value. Default: 4
#GLOBAL_MAX_SUBPROCESSES=4

# Distributed limit for in-process Pillow work across all worker replicas.
# Every replica must use the same positive value. Default: 1
#MAX_CONCURRENT_IMAGE_OPS=1


# 19. Observability
# ──────────────────────────────────────────────────────────────────────────────
# Bearer token required for scraping /metrics. Empty allows unauthenticated scraping.
# Default: (unset)
METRICS_TOKEN=

# OpenTelemetry Collector endpoint (e.g. localhost:4317). Empty disables export.
# Default: (unset)
OTEL_ENDPOINT=


# 20. Webhooks & Backups
# ──────────────────────────────────────────────────────────────────────────────
# HMAC-SHA256 signing secret for outgoing webhooks. Defaults to derivative of SECRET_KEY.
# Default: (unset)
WEBHOOK_SECRET=

# Directory path where the API writes database and volume backups.
# Default: /var/lib/lectern/backups
#BACKUP_DIR=/var/lib/lectern/backups
