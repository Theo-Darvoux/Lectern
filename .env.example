# ──────────────────────────────────────────────
# WikINT Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#
# All application settings now live here. The Admin Dashboard shows a
# read-only view of effective config; to change anything edit .env and redeploy.
# Run `docker compose exec api uv run python -m app.cli config-export-env` once
# against an existing instance to capture current DB values before upgrading.

# ─── General ───
# Generate a strong SECRET_KEY using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-string-with-at-least-32-bytes
ENVIRONMENT=development

# ─── PostgreSQL ───
POSTGRES_USER=wikint
POSTGRES_PASSWORD=wikint_dev_password
POSTGRES_DB=wikint
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Used by the API to connect to the database
DATABASE_URL=postgresql+asyncpg://wikint:wikint_dev_password@postgres:5432/wikint

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── Meilisearch ───
MEILI_MASTER_KEY=change-me-to-a-random-key
# Search-only key for the public search route. Provision via Meilisearch admin API.
MEILI_SEARCH_KEY=change-me-to-a-random-search-key
MEILI_URL=http://meilisearch:7700

# ─── Malware Scanning ───
YARA_RULES_DIR=yara_rules
MALWAREBAZAAR_TIMEOUT=10
# Optional: API key for MalwareBazaar to avoid higher rate limits
# MALWAREBAZAAR_API_KEY=your-api-key-here
# Whether a MalwareBazaar error should block the upload (fail-closed)
MALWAREBAZAAR_FAIL_CLOSED=false

# ─── EuroOffice Document Server ───
# JWT secret shared between the API and EuroOffice Document Server.
EUROOFFICE_JWT_SECRET=insecure-dev-only-eurooffice-secret
# Separate secret for file-access tokens (API-only, NOT shared with EuroOffice).
EUROOFFICE_FILE_TOKEN_SECRET=insecure-dev-only-eurooffice-file-token-secret
# Internal URL used by the EuroOffice container to fetch files from the API.
EUROOFFICE_INTERNAL_API_BASE_URL=http://api:8000

# ─── Network & Frontend ───
FRONTEND_URL=http://localhost:3000

# Browser-facing API URL. Defaults to /api.
NEXT_PUBLIC_API_URL=/api
# Browser-facing URL for EuroOffice. Defaults to /eurooffice.
NEXT_PUBLIC_EUROOFFICE_URL=http://localhost/eurooffice
# S3 public domain used by Nginx proxy in production.
S3_PUBLIC_DOMAIN=files.wikint.hypnos2026.fr

# ─── CORS ───
# Shared between FastAPI and Nginx. Comma-separated, no spaces.
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Client-ID,Accept,X-Requested-With

# ─── S3 Storage ───
# Backend selector. All backends speak S3; each carries a few quirks that the
# API handles automatically (see api/app/core/storage/backends.py).
#   r2        — Cloudflare R2 (production option)
#   seaweedfs — self-hosted SeaweedFS (the dev default; runs via compose.override.yaml)
#   garage    — self-hosted Garage
#   rustfs    — self-hosted RustFS
# Dev runs SeaweedFS out of the box. For a Cloudflare R2 deployment set
# STORAGE_BACKEND=r2 and point S3_ENDPOINT/keys at your R2 account.
STORAGE_BACKEND=seaweedfs
S3_ENDPOINT=seaweedfs:8333
S3_PUBLIC_ENDPOINT=localhost/s3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wikint
S3_USE_SSL=false
# S3_REGION=us-east-1
# MAX_STORAGE_GB=10

# Worker delivery (optional). When WORKER_ZIP_URL is set, single-file downloads
# and branding assets are served via an HMAC-signed worker (edge-cached) instead
# of presigned S3 GETs. Point it at EITHER the Cloudflare Worker OR the
# self-hosted Node worker (worker/src/node/server.ts) — identical token contract,
# so switching is URL-only. WORKER_ZIP_HMAC_SECRET must match the worker's secret.
# Leave blank to fall back to presigned S3 / server-side streaming.
WORKER_ZIP_URL=
WORKER_ZIP_HMAC_SECRET=

# ─── Authentication ───
# TOTP_ENABLED=true
# GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# CLASSIC_AUTH_ENABLED=false
# ALLOW_ALL_DOMAINS=false
# AUTO_APPROVE_ALL_DOMAINS=false
# GUEST_ACCESS_ENABLED=false

# Allowed email domains — comma-separated "domain:auto" or "domain:manual".
# "auto" = auto-approved on first login; "manual" = requires staff approval.
# When set, overrides the allowed_domains DB table (admin UI shows read-only).
# Leave empty to use the DB table (editable in admin → Authentication → Domains).
# Example: ALLOWED_DOMAINS="telecom-sudparis.eu:auto,imt-bs.eu:auto"
ALLOWED_DOMAINS=

# JWT token lifetimes
# JWT_ACCESS_TOKEN_EXPIRE_DAYS=7
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=31

# ─── SMTP / Email ───
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# SMTP_IP=                    # Override hostname with a specific IP for SMTP connection
# SMTP_SENDER_NAME=WikINT     # Display name shown in From: header
# SMTP_AVATAR_URL=            # URL of avatar image shown in verification emails

# ─── Branding ───
# SITE_NAME=WikINT
# SITE_DESCRIPTION=Wiki for SudParis Intelligence
# PRIMARY_COLOR=#3b82f6
# FOOTER_TEXT=© 2024 WikINT
# ORGANIZATION_URL=https://www.telecom-sudparis.eu

# Branding asset URLs — point at static files or S3 paths.
# SITE_LOGO_URL=
# SITE_FAVICON_URL=
# OG_IMAGE_URL=
# BG_WATERMARK_URL=
# BG_WATERMARK_OPACITY_LIGHT=0.05
# BG_WATERMARK_OPACITY_DARK=0.08
# FOOTER_LOGO_URL=
# SITE_NAME_STYLE=            # JSON array of styled name segments (advanced)

# ─── Legal / GDPR ───
# LEGAL_NAME=
# LEGAL_ADDRESS=
# LEGAL_SIRET=
# CONTACT_EMAIL=
# DPO_EMAIL=
# DPO_ADDRESS=
# DATA_TRANSFERS=
# LEGAL_VERSION=1.0

# ─── File Pipeline & Limits ───
# MAX_FILE_SIZE_MB=100
# MAX_SVG_SIZE_MB=5
# MAX_IMAGE_SIZE_MB=50
# MAX_AUDIO_SIZE_MB=200
# MAX_VIDEO_SIZE_MB=500
# MAX_DOCUMENT_SIZE_MB=200
# MAX_OFFICE_SIZE_MB=100
# MAX_TEXT_SIZE_MB=20
# PDF_QUALITY=75
# VIDEO_COMPRESSION_PROFILE=medium   # none|light|medium|aggressive|heavy|extreme
# THUMBNAIL_QUALITY=85
# THUMBNAIL_SIZE_PX=640
# ALLOWED_EXTENSIONS=               # comma-separated, e.g. ".pdf,.docx" (empty = all)
# ALLOWED_MIME_TYPES=               # comma-separated (empty = all)
