worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Map upgrade header for WebSockets
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    map $request_uri $loggable {
        /api/health 0;
        default 1;
    }

    # Social / link-preview crawlers don't run JS, so the static export's baked
    # <head> would show stale default branding. Route these User-Agents to the
    # backend OG renderer (location @og), which emits the live admin-config
    # branding. Everything else gets the static SPA untouched. Deliberately
    # excludes search engines (Googlebot, bingbot, …): they render JS and crawl
    # for indexing, so they must see the real SPA, not the OG stub.
    map $http_user_agent $is_bot {
        default 0;
        "~*(facebookexternalhit|facebookcatalog|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|redditbot|TelegramBot|vkShare|SkypeUriPreview|Embedly|Iframely|Mastodon|Bluesky)" 1;
    }

    # Deliberately omit query strings and Referer values. Capability URLs and
    # authentication callbacks may contain secrets even though access bearer
    # tokens are forbidden from browser request targets.
    log_format request_without_args '$remote_addr - $remote_user [$time_local] '
                                    '"$request_method $uri $server_protocol" '
                                    '$status $body_bytes_sent "$http_user_agent"';
    access_log /var/log/nginx/access.log request_without_args if=$loggable;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    client_max_body_size 500m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream api {
        server api:8000;
    }

    upstream web {
        server web:80;
    }

    server {
        listen 80;
        server_name _;

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        include /etc/nginx/nginx.eurooffice.snippet;

        location /api/ {
            set $api_backend api;
            proxy_pass http://$api_backend:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # Forward the protocol provided by the outer proxy
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

            # Keep connections open for SSE (text/event-stream)
            proxy_http_version 1.1;
            proxy_set_header Connection '';
            proxy_read_timeout 300s;
            proxy_buffering off;
            proxy_cache off;
        }

        location / {
            set $web_backend web;
            set $orig_uri $uri;
            error_page 463 = @og;
            if ($is_bot) {
                return 463;
            }
            proxy_pass http://$web_backend:80;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }

        # Backend-rendered Open Graph metadata for crawlers (see $is_bot map).
        location @og {
            set $api_backend api;
            rewrite ^ /api/og break;
            proxy_pass http://$api_backend:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header X-Original-Path $orig_uri;
        }
    }
}