worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Map upgrade header for WebSockets
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # The document server marks every asset response "immutable" for a year,
    # 404s included, so a file missing for a moment (fonts are generated at
    # boot) would stay broken in the CDN and browsers. Keep its caching for
    # successes only.
    map $status $eurooffice_cache_control {
        ~^[23]  $upstream_http_cache_control;
        default "no-store";
    }

    map $request_uri $loggable {
        /api/health 0;
        default 1;
    }

    # Deliberately omit query strings and Referer values. Capability URLs and
    # authentication callbacks may contain secrets even though access bearer
    # tokens are forbidden from browser request targets.
    log_format request_without_args '$remote_addr - $remote_user [$time_local] '
                                    '"$request_method $uri $server_protocol" '
                                    '$status $body_bytes_sent "$http_user_agent"';
    access_log /var/log/nginx/access.log request_without_args if=$loggable;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    client_max_body_size 500m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream api {
        server api:8000;
    }

    upstream web {
        server web:3000;
    }

    server {
        listen 80;
        server_name _;

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        include /etc/nginx/nginx.eurooffice.snippet;

        # Legacy batch archives need enough room for multipart framing and can
        # spend longer than the generic API timeout in isolated extraction.
        # The API still enforces the exact 500 MiB ZIP-content limit.
        location = /api/upload/batch-zip {
            set $api_backend api;
            proxy_pass http://$api_backend:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_http_version 1.1;
            proxy_set_header Connection '';
            client_max_body_size 501m;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location /api/ {
            set $api_backend api;
            proxy_pass http://$api_backend:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # Forward the protocol provided by the outer proxy
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

            # Keep connections open for SSE (text/event-stream)
            proxy_http_version 1.1;
            proxy_set_header Connection '';
            proxy_read_timeout 300s;
            proxy_buffering off;
            proxy_cache off;
        }

        # The Next server renders every page with the live branding and page
        # metadata, so browsers and link-preview crawlers get the same HTML.
        location / {
            set $web_backend web;
            proxy_pass http://$web_backend:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }
    }
}
