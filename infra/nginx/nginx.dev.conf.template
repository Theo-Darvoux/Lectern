worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    map $request_uri $loggable {
        /api/health 0;
        default 1;
    }

    # Social / link-preview crawlers don't run JS. Route them to the backend OG
    # renderer (location @og) so shared-link previews show the live admin-config
    # branding instead of the default baked <head>. Mirrors production nginx.
    # Excludes search engines (they render JS and must index the real SPA).
    map $http_user_agent $is_bot {
        default 0;
        "~*(facebookexternalhit|facebookcatalog|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|redditbot|TelegramBot|vkShare|SkypeUriPreview|Embedly|Iframely|Mastodon|Bluesky)" 1;
    }

    # SPA fallback (dev only). The Next pages keep `dynamicParams = false`
    # (required by the production `output: export`), so `next dev` 404s any
    # un-prerendered param like /browse/<id> or /profile/<real-id>. Map each
    # deep dynamic URL to the shell route Next did prerender; location / then
    # rewrites the upstream path to it while preserving the browser URL, so the
    # client SPA reads the real path via usePathname. Mirrors what the
    # production Nginx (web/nginx.conf) does with try_files. Regexes are tested
    # top-to-bottom — most specific first.
    map $uri $spa_shell {
        default "";
        "~^/pull-requests/[^/]+/preview/[^/]+"  "/pull-requests/_/preview/0/";
        "~^/pull-requests/[^/]+"                "/pull-requests/_/";
        "~^/qcm/new"                            "";
        "~^/qcm/preview"                        "";
        "~^/qcm/[^/]+/edit"                     "/qcm/_/edit/";
        "~^/qcm/[^/]+"                          "/qcm/_/";
        "~^/profile/[^/]+"                      "/profile/_/";
        "~^/browse/.+"                          "/browse/";
    }

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main if=$loggable;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 500m;

    upstream api {
        server api:8000;
    }

    upstream web {
        server web:3000;
    }

    upstream eurooffice {
        server eurooffice:80;
    }

    upstream seaweedfs {
        server seaweedfs:8333;
    }

    server {
        listen 80;
        server_name _;

        # API requests
        location /api/ {
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # The API container is local in development. Fail fast when it is
            # stopped instead of leaving frontend actions pending for ~60s.
            proxy_connect_timeout 3s;
        }

        # EuroOffice Routing Logic

        # A. Global catch-all for versioned paths (handles redirects that strip /eurooffice/)
        location ~* ^/(\d+\.\d+\.\d+[\.-][a-zA-Z0-9]+)/ {
            set $eurooffice_upstream http://eurooffice;
            proxy_pass $eurooffice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_buffering off;
            proxy_read_timeout 3600s;
        }
        
        # B. Specific fix for themes.json
        location ~* ^/(eurooffice/)?(\d+\.\d+\.\d+[\.-][a-zA-Z0-9]+)/themes.json$ {
            set $eurooffice_upstream http://eurooffice;
            rewrite ^ /web-apps/apps/themes/themes.json break;
            proxy_pass $eurooffice_upstream;
            proxy_set_header Host $host;
        }

        # C. Main EuroOffice block with prefix
        location /eurooffice/ {
            set $eurooffice_upstream http://eurooffice;
            rewrite ^/eurooffice/(.*)$ /$1 break;
            
            proxy_pass $eurooffice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            
            # WebSocket and performance optimizations
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            gzip off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_connect_timeout 60s;

            # Ensure redirects from EuroOffice include the /eurooffice/ prefix
            proxy_redirect / /eurooffice/;

            # Allow internal redirects and capture errors
            proxy_intercept_errors on;
            error_page 404 = @nextjs_fallback;
        }

        # D. Non-versioned EuroOffice asset and cache paths
        location ~* ^/(cache|web-apps|sdkjs|sdkjs-plugins|fonts|dictionaries|meta|printfile)/ {
            set $eurooffice_upstream http://eurooffice;
            proxy_pass $eurooffice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_intercept_errors on;
            error_page 404 = @nextjs_fallback;
        }

        # E. Direct API access (some versions use /doc/ or /coauthoring/ without version hash — EuroOffice)
        location ~* ^/(doc|coauthoring|downloadas|command|status|history|shards)/ {
            set $eurooffice_upstream http://eurooffice;
            proxy_pass $eurooffice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 3600s;
        }

        # Deny access to EuroOffice internal and admin paths
        location ~* ^/(converter|healthcheck)/ {
            return 403;
        }

        # Backend-rendered Open Graph metadata for crawlers (see $is_bot map).
        location @og {
            rewrite ^ /api/og break;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Original-Path $orig_uri;
        }

        # Main Frontend Application
        location / {
            set $orig_uri $uri;
            error_page 463 = @og;
            if ($is_bot) {
                return 463;
            }
            # Deep dynamic routes that next dev didn't prerender: serve the
            # matching shell upstream while keeping the browser URL intact.
            #
            # RSC payloads (*.txt) — full-page <path>/index.txt and Next 16
            # segment-cache <path>/__next.<seg>.txt — must collapse to the
            # shell's payload of the SAME basename, not the shell directory.
            # Rewriting them to the directory returns the HTML shell, which the
            # router rejects → full page reload (doMpaNavigation). This rewrite
            # only fires for *.txt; the directory rewrite below handles HTML.
            if ($spa_shell != "") {
                rewrite "^.*/([^/]+\.txt)$" "${spa_shell}$1" break;
            }
            if ($spa_shell != "") {
                rewrite ^ $spa_shell break;
            }
            proxy_pass http://web;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_connect_timeout 300s;
        }

        # Fallback for paths that matched the EuroOffice regex but returned 404.
        location @nextjs_fallback {
            proxy_pass http://web;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_connect_timeout 300s;
        }

        # Explicitly handle Next.js HMR
        location ~ ^/_next/(webpack-hmr|hmr) {
            proxy_pass http://web;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
        }

        # S3 Proxy with clean error handling
        location /s3/ {
            # Host is restored to the signed S3 endpoint so the SigV4 signature
            # (computed by the API against seaweedfs:8333) still validates.
            proxy_pass http://seaweedfs/;
            proxy_set_header Host "seaweedfs:8333";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            add_header X-Content-Type-Options "nosniff" always;
            proxy_intercept_errors on;
            error_page 403 =403 /error-expired.html;
        }

        location = /error-expired.html {
            root /etc/nginx/html;
            internal;
        }
    }
}
