worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # The document server marks every asset response "immutable" for a year,
    # 404s included, so a file missing for a moment (fonts are generated at
    # boot) would stay broken in the CDN and browsers. Keep its caching for
    # successes only.
    map $status $eurooffice_cache_control {
        ~^[23]  $upstream_http_cache_control;
        default "no-store";
    }

    map $request_uri $loggable {
        /api/health 0;
        default 1;
    }

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main if=$loggable;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 500m;

    # Lets optional services (the `eurooffice` profile) resolve per request,
    # so nginx starts even when they are not running.
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream api {
        server api:8000;
    }

    upstream web {
        server web:3000;
    }

    upstream seaweedfs {
        server seaweedfs:8333;
    }

    server {
        listen 80;
        server_name _;

        # Compatibility path for clients that still submit one folder archive.
        location = /api/upload/batch-zip {
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            client_max_body_size 501m;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_connect_timeout 3s;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # API requests
        location /api/ {
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # The API container is local in development. Fail fast when it is
            # stopped instead of leaving frontend actions pending for ~60s.
            proxy_connect_timeout 3s;
        }

        # EuroOffice Routing Logic

        # Deny the document server's internal and admin endpoints (conversion and
        # command APIs, health and stats pages, demo app), with or without the
        # /eurooffice/ prefix or a versioned build path. Regex locations match in
        # order, so this must stay before every other EuroOffice location.
        location ~* ^/(eurooffice/)?(\d+\.\d+\.\d+[\.-][a-zA-Z0-9]+/)?(converter|healthcheck|info|example|ConvertService\.ashx|coauthoring/CommandService\.ashx)(/|$) {
            return 403;
        }

        # A. Global catch-all for versioned paths (handles redirects that strip /eurooffice/)
        location ~* ^/(\d+\.\d+\.\d+[\.-][a-zA-Z0-9]+)/ {
            set $eurooffice_upstream http://eurooffice;
            proxy_pass $eurooffice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            # Errors are never cached (see the $eurooffice_cache_control map).
            proxy_hide_header Cache-Control;
            add_header Cache-Control $eurooffice_cache_control always;
        }
        
        # B. Specific fix for themes.json
        location ~* ^/(eurooffice/)?(\d+\.\d+\.\d+[\.-][a-zA-Z0-9]+)/themes.json$ {
            set $eurooffice_upstream http://eurooffice;
            rewrite ^ /web-apps/apps/themes/themes.json break;
            proxy_pass $eurooffice_upstream;
            proxy_set_header Host $host;
            # Errors are never cached (see the $eurooffice_cache_control map).
            proxy_hide_header Cache-Control;
            add_header Cache-Control $eurooffice_cache_control always;
        }

        # C. Main EuroOffice block with prefix
        location /eurooffice/ {
            set $eurooffice_upstream http://eurooffice;
            rewrite ^/eurooffice/(.*)$ /$1 break;
            
            proxy_pass $eurooffice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            
            # WebSocket and performance optimizations
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            gzip off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_connect_timeout 60s;

            # Errors are never cached (see the $eurooffice_cache_control map).
            proxy_hide_header Cache-Control;
            add_header Cache-Control $eurooffice_cache_control always;

            # Ensure redirects from EuroOffice include the /eurooffice/ prefix
            proxy_redirect / /eurooffice/;

            # Allow internal redirects and capture errors
            proxy_intercept_errors on;
            error_page 404 = @nextjs_fallback;
        }

        # D. Non-versioned EuroOffice asset and cache paths
        location ~* ^/(cache|web-apps|sdkjs|sdkjs-plugins|fonts|dictionaries|meta|printfile)/ {
            set $eurooffice_upstream http://eurooffice;
            proxy_pass $eurooffice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_intercept_errors on;
            error_page 404 = @nextjs_fallback;
            # Errors are never cached (see the $eurooffice_cache_control map).
            proxy_hide_header Cache-Control;
            add_header Cache-Control $eurooffice_cache_control always;
        }

        # E. Direct API access (some versions use /doc/ or /coauthoring/ without version hash — EuroOffice)
        location ~* ^/(doc|coauthoring|downloadas|command|status|history|shards)/ {
            set $eurooffice_upstream http://eurooffice;
            proxy_pass $eurooffice_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 3600s;
        }

        # Main Frontend Application
        location / {
            proxy_pass http://web;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_connect_timeout 300s;
        }

        # Fallback for paths that matched the EuroOffice regex but returned 404.
        location @nextjs_fallback {
            proxy_pass http://web;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_connect_timeout 300s;
        }

        # Explicitly handle Next.js HMR
        location ~ ^/_next/(webpack-hmr|hmr) {
            proxy_pass http://web;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
        }

        # S3 Proxy with clean error handling
        location /s3/ {
            # Host is restored to the signed S3 endpoint so the SigV4 signature
            # (computed by the API against seaweedfs:8333) still validates.
            proxy_pass http://seaweedfs/;
            proxy_set_header Host "seaweedfs:8333";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            add_header X-Content-Type-Options "nosniff" always;
            proxy_intercept_errors on;
            error_page 403 =403 /error-expired.html;
        }

        location = /error-expired.html {
            root /etc/nginx/html;
            internal;
        }
    }
}
