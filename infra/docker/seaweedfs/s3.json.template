{
  "_comment": "SeaweedFS S3 identity config. Credentials are injected at deploy time via envsubst (see Makefile / deploy script). The anonymous identity grants public read on branding/ only; all write access requires credentials.",
  "identities": [
    {
      "name": "lectern",
      "credentials": [
        {
          "accessKey": "${S3_ACCESS_KEY}",
          "secretKey": "${S3_SECRET_KEY}"
        }
      ],
      "actions": ["Admin", "Read", "Write", "List", "Tagging"]
    },
    {
      "name": "anonymous",
      "actions": ["Read:${S3_BUCKET}/branding"]
    }
  ]
}
