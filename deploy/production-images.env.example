# Copy to a release-specific, access-controlled file. This parser is not a
# shell: use exact unquoted KEY=VALUE lines and do not add runtime settings.
RELEASE_COMMIT=<40-hex-release-commit>
# Valid values are any comma-separated combination of postgres, seaweedfs-prod,
# and selfhost-worker. Use COMPOSE_PROFILES= (empty) for external PostgreSQL and
# external S3/R2. Omit profile-only image variables for disabled profiles.
COMPOSE_PROFILES=postgres,seaweedfs-prod,selfhost-worker

API_IMAGE=ghcr.io/theo-darvoux/lectern/api-release@sha256:<64-hex-manifest-digest>
WORKER_IMAGE=ghcr.io/theo-darvoux/lectern/worker-release@sha256:<64-hex-manifest-digest>
WEB_IMAGE=ghcr.io/theo-darvoux/lectern/web-release@sha256:<64-hex-manifest-digest>
SELFHOST_WORKER_IMAGE=ghcr.io/theo-darvoux/lectern/selfhost-worker-release@sha256:<64-hex-manifest-digest>

POLICY_IMAGE_DIGEST=sha256:<64-hex-manifest-digest>
POSTGRES_IMAGE=docker.io/library/postgres@sha256:<64-hex-manifest-digest>
REDIS_IMAGE=docker.io/library/redis@sha256:<64-hex-manifest-digest>
NGINX_IMAGE=docker.io/library/nginx@sha256:<64-hex-manifest-digest>
MEILI_IMAGE=docker.io/getmeili/meilisearch@sha256:<64-hex-manifest-digest>
EUROOFFICE_IMAGE=ghcr.io/euro-office/documentserver@sha256:<64-hex-manifest-digest>
SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs@sha256:<64-hex-manifest-digest>
